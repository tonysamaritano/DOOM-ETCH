option(DOOM_SANITIZERS "Enable AddressSanitizer and UndefinedBehaviorSanitizer" OFF)
option(DOOM_COVERAGE "Enable LLVM source coverage" OFF)
if(DOOM_SANITIZERS AND DOOM_COVERAGE)
    message(FATAL_ERROR "Use separate sanitizer and coverage build directories")
endif()
if(DOOM_SANITIZERS)
    add_compile_options(-fno-common -fsanitize=address,undefined
        -fno-sanitize-recover=all -fno-omit-frame-pointer -g)
    add_link_options(-fsanitize=address,undefined)
endif()
if(DOOM_COVERAGE)
    add_compile_options(-fprofile-instr-generate -fcoverage-mapping -O0 -g)
    add_link_options(-fprofile-instr-generate)
endif()
