{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 21, "patch": 0},
  "configurePresets": [
    {"name": "test", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/build/test", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}},
    {"name": "sanitize", "inherits": "test", "binaryDir": "${sourceDir}/build/sanitize", "cacheVariables": {"DOOM_SANITIZERS": "ON"}},
    {"name": "coverage", "inherits": "test", "binaryDir": "${sourceDir}/build/coverage", "cacheVariables": {"DOOM_COVERAGE": "ON"}}
  ],
  "buildPresets": [
    {"name": "test", "configurePreset": "test"},
    {"name": "sanitize", "configurePreset": "sanitize"},
    {"name": "coverage", "configurePreset": "coverage"}
  ],
  "testPresets": [
    {"name": "test", "configurePreset": "test", "output": {"outputOnFailure": true}},
    {"name": "sanitize", "configurePreset": "sanitize", "output": {"outputOnFailure": true}, "environment": {"UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1", "ASAN_OPTIONS": "halt_on_error=1"}},
    {"name": "coverage", "configurePreset": "coverage", "output": {"outputOnFailure": true}, "environment": {"LLVM_PROFILE_FILE": "${sourceDir}/build/coverage/%p-%m.profraw"}}
  ]
}
