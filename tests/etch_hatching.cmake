function(read_path_metric output key destination)
    string(REGEX MATCH "${key}=([^ \r\n]+)" record "${output}")
    if(NOT record)
        message(FATAL_ERROR "Export did not report ${key}: ${output}")
    endif()
    set(value "${CMAKE_MATCH_1}")
    if(NOT value MATCHES "^[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?$" OR NOT value GREATER 0)
        message(FATAL_ERROR "Export reported invalid ${key}: ${value}")
    endif()
    set(${destination} "${value}" PARENT_SCOPE)
endfunction()

function(check_hatch_export mode)
    execute_process(COMMAND "${EXPORTER}" "${WAD}" "${PREFIX}-${mode}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} hatch export failed: ${output}${errors}")
    endif()
    if(NOT EXISTS "${PREFIX}-${mode}.gcode")
        message(FATAL_ERROR "${mode} hatch export omitted G-code")
    endif()
    string(REGEX MATCH "([0-9]+) moves" reported "${output}")
    if(NOT reported)
        message(FATAL_ERROR "${mode} export did not report moves: ${output}")
    endif()
    set(moves "${CMAKE_MATCH_1}")
    execute_process(COMMAND "${VALIDATOR}" "${PREFIX}-${mode}.svg"
        RESULT_VARIABLE result OUTPUT_VARIABLE validation ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} hatch SVG is invalid: ${validation}${errors}")
    endif()
    string(REGEX MATCH "([0-9]+) moves" reported "${validation}")
    if(NOT reported OR NOT "${CMAKE_MATCH_1}" STREQUAL "${moves}")
        message(FATAL_ERROR "${mode} SVG disagrees with its export move report")
    endif()
    read_path_metric("${output}" length_mm length)
    read_path_metric("${output}" estimate_seconds seconds)
    file(SHA256 "${PREFIX}-${mode}.svg" hash)
    foreach(key moves length seconds hash)
        set(${key}_${mode} "${${key}}" PARENT_SCOPE)
    endforeach()
    message(STATUS "${mode}: ${moves} moves, ${length} mm, ${seconds} ideal seconds")
endfunction()

foreach(argument EXPORTER WAD PREFIX VALIDATOR)
    if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
        message(FATAL_ERROR "etch-hatching requires ${argument}")
    endif()
endforeach()
check_hatch_export(default)
check_hatch_export(no-wall --no-textures)
check_hatch_export(no-sprite --no-sprite-textures)
check_hatch_export(no-weapon --no-weapon-textures)
foreach(pattern RANGE 0 2)
    check_hatch_export(pattern-${pattern} --hatch-pattern ${pattern})
endforeach()
foreach(mode no-wall no-sprite no-weapon)
    if(length_${mode} EQUAL length_default OR hash_${mode} STREQUAL hash_default)
        message(FATAL_ERROR "The independent ${mode} hatch switch did not change the path")
    endif()
endforeach()
if(NOT length_pattern-2 GREATER length_pattern-0)
    message(FATAL_ERROR "Crosshatch must be longer than horizontal hatching")
endif()
if(NOT length_default EQUAL length_pattern-2 OR NOT hash_default STREQUAL hash_pattern-2)
    message(FATAL_ERROR "Default hatching must agree with explicit crosshatch")
endif()
