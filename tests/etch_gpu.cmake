foreach(argument GAME WAD CONFIG)
    if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
        message(FATAL_ERROR "etch-gpu requires ${argument}")
    endif()
endforeach()
# WAD is the configured directory, or the selected doom1.wad itself.
if(IS_DIRECTORY "${WAD}")
    set(wad_directory "${WAD}")
else()
    get_filename_component(wad_directory "${WAD}" DIRECTORY)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "DOOMWADDIR=${wad_directory}"
    "${GAME}" --etch-gpu -warp 1 1 -nosound --run-frames 120 -config "${CONFIG}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
set(log "${output}\n${errors}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "GPU run failed (${result}): ${log}")
endif()
string(REGEX MATCH "Presented[ \t]+([0-9]+)[ \t]+frames" presented "${log}")
if(NOT presented OR NOT "${CMAKE_MATCH_1}" EQUAL 120)
    message(FATAL_ERROR "GPU run did not present exactly 120 frames: ${log}")
endif()
string(REGEX MATCH "Etch GPU:[ \t]*frames=([0-9]+)[ \t]+uploads=([0-9]+)" gpu "${log}")
if(NOT gpu OR NOT "${CMAKE_MATCH_1}" EQUAL 120 OR "${CMAKE_MATCH_2}" LESS 1)
    message(FATAL_ERROR "GPU run did not report 120 GPU frames and a path upload: ${log}")
endif()
message(STATUS "${gpu}; ${presented}")
