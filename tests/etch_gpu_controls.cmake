foreach(argument GAME WAD CONFIG)
    if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
        message(FATAL_ERROR "etch-gpu-controls requires ${argument}")
    endif()
endforeach()
if(IS_DIRECTORY "${WAD}")
    set(wad_directory "${WAD}")
else()
    get_filename_component(wad_directory "${WAD}" DIRECTORY)
endif()
function(reject_rate label)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "DOOMWADDIR=${wad_directory}"
        "${GAME}" --etch-gpu -warp 1 1 -nosound --run-frames 1 -config "${CONFIG}"
        --etch-gpu-rate ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
    if(result EQUAL 0)
        message(FATAL_ERROR "Invalid GPU rate ${label} was accepted")
    endif()
    if(NOT "${output}${errors}" MATCHES "etch-gpu-rate")
        message(FATAL_ERROR "Rate ${label} did not fail through argument validation: ${output}${errors}")
    endif()
endfunction()

reject_rate(missing)
foreach(value IN ITEMS nan inf 64junk 0 -1 0.015624 1024.0001)
    reject_rate("${value}" "${value}")
endforeach()
string(TIMESTAMP started_us "%s%f" UTC)
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "DOOMWADDIR=${wad_directory}"
    "${GAME}" --etch-gpu --etch-gpu-instant --etch-gpu-rate 64
    -warp 1 1 -nosound --run-frames 120 -config "${CONFIG}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
string(TIMESTAMP finished_us "%s%f" UTC)
set(log "${output}\n${errors}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Instant GPU run failed (${result}): ${log}")
endif()
string(REGEX MATCH "Presented[ \t]+([0-9]+)[ \t]+frames" presented "${log}")
if(NOT presented OR NOT "${CMAKE_MATCH_1}" EQUAL 120)
    message(FATAL_ERROR "Instant GPU run did not present exactly 120 frames: ${log}")
endif()
string(REGEX MATCH "Etch GPU:[ \t]*frames=([0-9]+)[ \t]+uploads=([0-9]+)" gpu "${log}")
set(gpu_frames "${CMAKE_MATCH_1}")
set(uploads "${CMAKE_MATCH_2}")
if(NOT gpu OR NOT gpu_frames EQUAL 120 OR uploads LESS 2)
    message(FATAL_ERROR "Instant GPU run needs 120 GPU frames and repeated path uploads: ${log}")
endif()
math(EXPR elapsed_us "${finished_us} - ${started_us}")
if(NOT elapsed_us GREATER 0)
    message(FATAL_ERROR "Instant GPU elapsed wall-clock time was not measurable")
endif()
math(EXPR average_frame_us "${elapsed_us} / 120")
message(STATUS "Instant GPU: frames=${gpu_frames} uploads=${uploads} wall_clock_us=${elapsed_us} average_frame_us=${average_frame_us} (including startup)")
