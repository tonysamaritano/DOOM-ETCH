function(check_sprite_export mode)
    set(options --no-hud --no-weapon)
    if(mode STREQUAL "walls")
        list(APPEND options --no-sprites)
    endif()
    execute_process(COMMAND "${EXPORTER}" "${WAD}" "${PREFIX}-${mode}" ${options}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} export failed: ${output}${errors}")
    endif()
    if(NOT EXISTS "${PREFIX}-${mode}.gcode")
        message(FATAL_ERROR "${mode} export omitted G-code")
    endif()
    string(REGEX MATCH "([0-9]+) moves" reported "${output}")
    if(NOT reported)
        message(FATAL_ERROR "${mode} export did not report moves: ${output}")
    endif()
    set(expected_moves "${CMAKE_MATCH_1}")
    execute_process(COMMAND "${VALIDATOR}" "${PREFIX}-${mode}.svg"
        RESULT_VARIABLE result OUTPUT_VARIABLE validation ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} SVG is invalid: ${validation}${errors}")
    endif()
    string(REGEX MATCH "([0-9]+) moves" reported "${validation}")
    if(NOT reported OR NOT "${CMAKE_MATCH_1}" STREQUAL "${expected_moves}")
        message(FATAL_ERROR "${mode} move report disagrees with its SVG")
    endif()
    set(moves_${mode} "${expected_moves}" PARENT_SCOPE)
    file(SHA256 "${PREFIX}-${mode}.svg" hash)
    set(hash_${mode} "${hash}" PARENT_SCOPE)
endfunction()

foreach(argument EXPORTER WAD PREFIX VALIDATOR)
    if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
        message(FATAL_ERROR "etch-sprites requires ${argument}")
    endif()
endforeach()
check_sprite_export(sprites)
check_sprite_export(walls)
if(moves_sprites STREQUAL moves_walls OR hash_sprites STREQUAL hash_walls)
    message(FATAL_ERROR "The sprite toggle did not change the geometry and move count")
endif()
message(STATUS "Sprite toggle: ${moves_sprites} moves versus ${moves_walls} walls-only moves")
