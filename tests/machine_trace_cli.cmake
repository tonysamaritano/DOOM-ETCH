foreach(argument RUNNER PREFIX)
    if(NOT DEFINED ${argument})
        message(FATAL_ERROR "machine-trace-cli requires ${argument}")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/first_frame_helpers.cmake")
set(source "; quoted \"source\" and a tab\t\n; ETCH_START X0 Y127.6\nG1 X100 F3600\nM0\nG1 X0\nM2\n")
file(WRITE "${PREFIX}.gcode" "${source}")
execute_process(COMMAND "${RUNNER}" "${PREFIX}.gcode" --machine-readable
    RESULT_VARIABLE plain_status OUTPUT_VARIABLE plain ERROR_VARIABLE errors TIMEOUT 15)
execute_process(COMMAND "${RUNNER}" "${PREFIX}.gcode" --trace "${PREFIX}.json" --machine-readable
    RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE errors TIMEOUT 15)
if(NOT plain_status EQUAL 0 OR NOT status EQUAL 0 OR NOT report STREQUAL plain)
    message(FATAL_ERROR "Tracing changed physical results or failed: ${plain} / ${report}${errors}")
endif()
file(READ "${PREFIX}.json" trace)
string(JSON format GET "${trace}" format)
string(JSON version GET "${trace}" version)
string(JSON gcode GET "${trace}" gcode)
if(NOT format STREQUAL "doom-etch-trace" OR NOT version EQUAL 1 OR NOT gcode STREQUAL source)
    message(FATAL_ERROR "Trace format or exact escaped source is wrong")
endif()
string(JSON clock GET "${trace}" duration)
string(JSON seconds GET "${trace}" simulated_seconds)
string(JSON reported GET "${report}" simulated_seconds)
if(NOT clock STREQUAL seconds OR NOT clock STREQUAL reported)
    message(FATAL_ERROR "Trace and report clocks differ: ${clock}, ${seconds}, ${reported}")
endif()
set(fields t0 duration ramp peak accel slack length x0 y0 ux uy motor_x0 motor_y0 line frame)
string(JSON field_count LENGTH "${trace}" segment_fields)
string(JSON values LENGTH "${trace}" segments)
string(JSON erase_count LENGTH "${trace}" erases)
if(NOT field_count EQUAL 15 OR NOT values EQUAL 30 OR NOT erase_count EQUAL 1)
    message(FATAL_ERROR "Trace has wrong segment or erase dimensions")
endif()
foreach(index RANGE 0 14)
    list(GET fields ${index} expected)
    string(JSON actual GET "${trace}" segment_fields ${index})
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Trace column ${index}: ${actual} != ${expected}")
    endif()
endforeach()
foreach(pair "13;3" "14;0" "28;5" "29;1")
    list(GET pair 0 index)
    list(GET pair 1 expected)
    string(JSON actual GET "${trace}" segments ${index})
    if(NOT actual EQUAL expected)
        message(FATAL_ERROR "Trace lost source line/frame at ${index}")
    endif()
endforeach()
string(JSON assumed GET "${trace}" settings assumed)
string(JSON width GET "${trace}" settings width_mm)
string(JSON height GET "${trace}" settings height_mm)
if(NOT assumed OR NOT width EQUAL 170.15 OR NOT height EQUAL 127.6)
    message(FATAL_ERROR "Trace calibration assumptions or real travel changed")
endif()
reject_command(missing-trace "trace" "${RUNNER}" "${PREFIX}.gcode" --trace)
reject_command(empty-trace "trace|output" "${RUNNER}" "${PREFIX}.gcode" --trace "")
reject_command(repeated-trace "trace" "${RUNNER}" "${PREFIX}.gcode"
    --trace "${PREFIX}-a.json" --trace "${PREFIX}-b.json")
reject_command(source-output-alias "trace|source|input|same" "${RUNNER}"
    "${PREFIX}.gcode" --trace "${PREFIX}.gcode")
file(READ "${PREFIX}.gcode" preserved)
if(NOT preserved STREQUAL source)
    message(FATAL_ERROR "Rejected trace destination damaged source")
endif()
file(CREATE_LINK "${PREFIX}.gcode" "${PREFIX}-alias.gcode" SYMBOLIC RESULT linked)
if(NOT linked EQUAL 0)
    message(FATAL_ERROR "Cannot prepare source-alias regression: ${linked}")
endif()
reject_command(source-inode-alias "trace|source|input|same" "${RUNNER}"
    "${PREFIX}.gcode" --trace "${PREFIX}-alias.gcode")
file(WRITE "${PREFIX}-bad.gcode" "G2 X1\n")
file(WRITE "${PREFIX}-saved.json" "previous trace\n")
reject_command(invalid-input "1:" "${RUNNER}" "${PREFIX}-bad.gcode"
    --trace "${PREFIX}-saved.json")
file(READ "${PREFIX}-saved.json" preserved)
if(NOT preserved STREQUAL "previous trace\n")
    message(FATAL_ERROR "Invalid input damaged an existing trace")
endif()
reject_command(output-directory "trace|output|directory" "${RUNNER}"
    "${PREFIX}.gcode" --trace "${PREFIX}-missing/out.json")
# Feed-group sums may associate differently while representing the same clock.
set(groups "; ETCH_START X0 Y127.6\nF3600\n")
foreach(i RANGE 1 30)
    math(EXPR change "(${i} - 1) % 3")
    if(change EQUAL 0)
        math(EXPR feed "(${i} % 5 + 1) * 600")
        string(APPEND groups "F${feed}\n")
    endif()
    math(EXPR x "(${i} * 17) % 170")
    math(EXPR y "(${i} * 11) % 127")
    string(APPEND groups "G1 X${x}.15 Y${y}.55\n")
    math(EXPR shake "${i} % 7")
    if(shake EQUAL 0)
        string(APPEND groups "M0\n")
    endif()
endforeach()
file(WRITE "${PREFIX}-groups.gcode" "${groups}M2\n")
execute_process(COMMAND "${RUNNER}" "${PREFIX}-groups.gcode"
    --trace "${PREFIX}-groups.json" --machine-readable
    RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE errors TIMEOUT 15)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Mixed feed and erase trace failed: ${report}${errors}")
endif()
file(READ "${PREFIX}-groups.json" trace)
string(JSON clock GET "${trace}" duration)
string(JSON seconds GET "${report}" simulated_seconds)
string(JSON values LENGTH "${trace}" segments)
string(JSON erases LENGTH "${trace}" erases)
if(NOT clock STREQUAL seconds OR NOT values EQUAL 450 OR NOT erases EQUAL 4)
    message(FATAL_ERROR "Mixed feed trace lost records or disagrees with playback")
endif()
