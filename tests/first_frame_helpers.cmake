function(machine_summary text destination)
    string(REGEX MATCH "\\{[^\n]*\"type\":\"machine-summary\"[^\n]*\\}" report "${text}")
    if(report STREQUAL "")
        message(FATAL_ERROR "Missing completed physical report: ${text}")
    endif()
    string(JSON seconds GET "${report}" simulated_seconds)
    if(NOT seconds GREATER 0)
        message(FATAL_ERROR "Invalid physical seconds: ${report}")
    endif()
    foreach(field moves erases steps_x steps_y reversals_x reversals_y)
        string(JSON value GET "${report}" ${field})
        if(NOT value MATCHES "^[0-9]+$")
            message(FATAL_ERROR "Noninteger ${field}: ${report}")
        endif()
    endforeach()
    set(${destination} "${report}" PARENT_SCOPE)
endfunction()

function(reject_command label expected)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
    if(status EQUAL 0 OR NOT "${output}${errors}" MATCHES "${expected}")
        message(FATAL_ERROR "${label} did not reject with a diagnostic: ${status} ${output}${errors}")
    endif()
endfunction()
