function(check_overlay mode)
    execute_process(COMMAND "${EXPORTER}" "${WAD}" "${PREFIX}-${mode}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} overlay export failed: ${output}${errors}")
    endif()
    if(NOT EXISTS "${PREFIX}-${mode}.gcode")
        message(FATAL_ERROR "${mode} overlay export omitted G-code")
    endif()
    string(REGEX MATCH "([0-9]+) moves" reported "${output}")
    if(NOT reported)
        message(FATAL_ERROR "${mode} export did not report moves: ${output}")
    endif()
    set(expected_moves "${CMAKE_MATCH_1}")
    execute_process(COMMAND "${VALIDATOR}" "${PREFIX}-${mode}.svg"
        RESULT_VARIABLE result OUTPUT_VARIABLE validation ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} overlay SVG is invalid: ${validation}${errors}")
    endif()
    string(REGEX MATCH "([0-9]+) moves" reported "${validation}")
    if(NOT reported OR NOT "${CMAKE_MATCH_1}" STREQUAL "${expected_moves}")
        message(FATAL_ERROR "${mode} SVG disagrees with its export move report")
    endif()
    set(moves_${mode} "${expected_moves}" PARENT_SCOPE)
    file(SHA256 "${PREFIX}-${mode}.svg" hash)
    set(hash_${mode} "${hash}" PARENT_SCOPE)
    set(validation_${mode} "${validation}" PARENT_SCOPE)
endfunction()
