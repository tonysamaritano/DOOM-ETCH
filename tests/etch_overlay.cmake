function(check_overlay mode)
    execute_process(COMMAND "${EXPORTER}" "${WAD}" "${PREFIX}-${mode}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} overlay export failed: ${output}${errors}")
    endif()
    if(NOT EXISTS "${PREFIX}-${mode}.gcode")
        message(FATAL_ERROR "${mode} overlay export omitted G-code")
    endif()
    string(REGEX MATCH "([0-9]+) moves" reported "${output}")
    if(NOT reported)
        message(FATAL_ERROR "${mode} export did not report moves: ${output}")
    endif()
    set(expected_moves "${CMAKE_MATCH_1}")
    execute_process(COMMAND "${VALIDATOR}" "${PREFIX}-${mode}.svg"
        RESULT_VARIABLE result OUTPUT_VARIABLE validation ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} overlay SVG is invalid: ${validation}${errors}")
    endif()
    string(REGEX MATCH "([0-9]+) moves" reported "${validation}")
    if(NOT reported OR NOT "${CMAKE_MATCH_1}" STREQUAL "${expected_moves}")
        message(FATAL_ERROR "${mode} SVG disagrees with its export move report")
    endif()
    set(moves_${mode} "${expected_moves}" PARENT_SCOPE)
    file(SHA256 "${PREFIX}-${mode}.svg" hash)
    set(hash_${mode} "${hash}" PARENT_SCOPE)
    set(validation_${mode} "${validation}" PARENT_SCOPE)
endfunction()

foreach(argument EXPORTER WAD PREFIX VALIDATOR)
    if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
        message(FATAL_ERROR "etch-overlay requires ${argument}")
    endif()
endforeach()
check_overlay(default)
check_overlay(no-hud --no-hud)
check_overlay(no-weapon --no-weapon)
check_overlay(neither --no-weapon --no-hud)
foreach(pair "default;no-hud" "default;no-weapon" "no-hud;neither" "no-weapon;neither")
    list(GET pair 0 enabled)
    list(GET pair 1 disabled)
    if(NOT moves_${enabled} GREATER moves_${disabled})
        message(FATAL_ERROR "${enabled} must add moves over ${disabled}")
    endif()
    if(hash_${enabled} STREQUAL hash_${disabled})
        message(FATAL_ERROR "${enabled} must change geometry from ${disabled}")
    endif()
endforeach()
message(STATUS "Overlay moves: default=${moves_default}, no-hud=${moves_no-hud}, no-weapon=${moves_no-weapon}, neither=${moves_neither}")

check_overlay(neither-reordered --no-hud --no-weapon --no-hud --no-weapon)
if(NOT moves_neither-reordered EQUAL moves_neither OR
        NOT hash_neither-reordered STREQUAL hash_neither)
    message(FATAL_ERROR "Layer option order or duplication changed the same disabled view")
endif()
