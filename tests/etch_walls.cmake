foreach(argument EXPORTER WAD PREFIX VALIDATOR)
    if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
        message(FATAL_ERROR "etch-walls requires ${argument}")
    endif()
endforeach()
execute_process(COMMAND "${EXPORTER}" "${WAD}" "${PREFIX}" --no-sprites --no-hud --no-weapon
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Wall export failed (${result}): ${output}${errors}")
endif()
if(NOT EXISTS "${PREFIX}.svg" OR NOT EXISTS "${PREFIX}.gcode")
    message(FATAL_ERROR "Exporter did not write both native outputs")
endif()
string(REGEX MATCH "([0-9]+) moves" reported "${output}")
if(NOT reported)
    message(FATAL_ERROR "Exporter did not report its move count: ${output}")
endif()
set(export_moves "${CMAKE_MATCH_1}")
execute_process(COMMAND "${VALIDATOR}" "${PREFIX}.svg"
    RESULT_VARIABLE result OUTPUT_VARIABLE validation ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "SVG bounds check failed (${result}): ${validation}${errors}")
endif()
string(REGEX MATCH "([0-9]+) moves" reported "${validation}")
if(NOT reported OR NOT "${CMAKE_MATCH_1}" STREQUAL "${export_moves}")
    message(FATAL_ERROR "Export and SVG move counts disagree: ${output}${validation}")
endif()
message(STATUS "${validation}")
