foreach(argument RUNNER EXPORTER GAME PREFIX)
    if(NOT DEFINED ${argument})
        message(FATAL_ERROR "gcode-runner requires ${argument}")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/first_frame_helpers.cmake")
file(WRITE "${PREFIX}.gcode" "; ETCH_SIZE X170.15 Y127.6\n; ETCH_START X0 Y127.6\nG21\nG90\nF3600\nG1 X0.1 Y127.6\nM2\n")
execute_process(COMMAND "${RUNNER}" "${PREFIX}.gcode" --machine-readable
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Short physical run failed: ${output}${errors}")
endif()
machine_summary("${output}" report)
foreach(field moves steps_x)
    string(JSON value GET "${report}" ${field})
    if((field STREQUAL "moves" AND NOT value EQUAL 1) OR
       (field STREQUAL "steps_x" AND NOT value EQUAL 2))
        message(FATAL_ERROR "Incorrect short-path ${field}: ${report}")
    endif()
endforeach()
string(JSON seconds GET "${report}" simulated_seconds)
if(seconds LESS 0.0399999999 OR seconds GREATER 0.0400000001)
    message(FATAL_ERROR "Short profile is not analytic .04s: ${report}")
endif()
file(WRITE "${PREFIX}-report.json" "${report}\n")
foreach(field erases steps_y reversals_x reversals_y)
    string(JSON value GET "${report}" ${field})
    if(NOT value EQUAL 0)
        message(FATAL_ERROR "Unexpected short-path ${field}: ${report}")
    endif()
endforeach()
execute_process(COMMAND "${RUNNER}" "${PREFIX}.gcode" --settings "$100=40" --machine-readable
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Settings override failed: ${output}${errors}")
endif()
machine_summary("${output}" adjusted)
string(JSON steps GET "${adjusted}" steps_x)
if(NOT steps EQUAL 4)
    message(FATAL_ERROR "Steps/mm override not applied: ${adjusted}")
endif()
reject_command(no-file "[Uu]sage" "${RUNNER}")
reject_command(missing-setting "settings" "${RUNNER}" "${PREFIX}.gcode" --settings)
foreach(setting "$100=0" "$110=nan" "$120=inf" "ghost=1.1" "unknown=1" "$100=20junk")
    reject_command(bad-setting "[Ss]etting|${setting}" "${RUNNER}" "${PREFIX}.gcode" --settings "${setting}")
endforeach()
reject_command(unknown "unknown|Unknown" "${RUNNER}" "${PREFIX}.gcode" --bogus)
reject_command(runner-rate "etch-time-scale" "${RUNNER}" "${PREFIX}.gcode" --etch-time-scale 1000)
reject_command(export-rate "etch-time-scale" "${EXPORTER}" missing.wad "${PREFIX}-invalid" --etch-time-scale 1000)
set(missing "${PREFIX}-does-not-exist.gcode")
reject_command(orphan-rate "etch-time-scale|etch-gcode" "${GAME}" --etch-time-scale 1)
reject_command(missing-standalone "etch-gcode" "${GAME}" --etch-gcode)
foreach(rate nan inf -inf 0 -1 0.015624 1024.001 1025 1junk)
    reject_command(invalid-rate "[Rr]ate|scale" "${GAME}" --etch-gcode "${missing}" --etch-time-scale "${rate}")
endforeach()
reject_command(missing-rate "[Rr]ate|scale" "${GAME}" --etch-gcode "${missing}" --etch-time-scale)
foreach(rate 0.015625 1 1000 1024)
    reject_command(valid-rate-missing-file "does-not-exist.gcode" "${GAME}"
        --etch-gcode "${missing}" --etch-time-scale "${rate}")
endforeach()
reject_command(conflicting-mode "etch-gpu|standalone|[Cc]onflict" "${GAME}"
    --etch-gcode "${missing}" --etch-gpu)
foreach(kind empty end-only)
    if(kind STREQUAL "empty")
        file(WRITE "${PREFIX}-${kind}.gcode" "")
    else()
        file(WRITE "${PREFIX}-${kind}.gcode" "M2\n")
    endif()
    execute_process(COMMAND "${RUNNER}" "${PREFIX}-${kind}.gcode" --machine-readable
        RESULT_VARIABLE result OUTPUT_VARIABLE zero ERROR_VARIABLE errors TIMEOUT 15)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${kind} file failed: ${zero}${errors}")
    endif()
    foreach(field moves erases steps_x steps_y reversals_x reversals_y simulated_seconds)
        string(JSON value GET "${zero}" ${field})
        if(NOT value EQUAL 0)
            message(FATAL_ERROR "${kind} has nonzero ${field}: ${zero}")
        endif()
    endforeach()
endforeach()
