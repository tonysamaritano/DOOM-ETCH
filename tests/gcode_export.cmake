foreach(argument EXPORTER WAD PREFIX VALIDATOR CHECKER)
    if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
        message(FATAL_ERROR "gcode-frames requires ${argument}")
    endif()
endforeach()
function(export_frames mode)
    execute_process(COMMAND "${EXPORTER}" "${WAD}" "${PREFIX}-${mode}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} export failed: ${output}${errors}")
    endif()
    execute_process(COMMAND "${VALIDATOR}" "${PREFIX}-${mode}.svg"
        RESULT_VARIABLE result OUTPUT_VARIABLE validation ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} SVG failed: ${validation}${errors}")
    endif()
endfunction()
export_frames(default)
export_frames(one --frames 1)
foreach(extension svg gcode)
    file(SHA256 "${PREFIX}-default.${extension}" original)
    file(SHA256 "${PREFIX}-one.${extension}" explicit)
    if(NOT original STREQUAL explicit)
        message(FATAL_ERROR "--frames 1 changed default ${extension} bytes")
    endif()
endforeach()
