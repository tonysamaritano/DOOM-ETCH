foreach(argument EXPORTER WAD PREFIX VALIDATOR CHECKER)
    if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
        message(FATAL_ERROR "gcode-frames requires ${argument}")
    endif()
endforeach()
function(export_frames mode)
    execute_process(COMMAND "${EXPORTER}" "${WAD}" "${PREFIX}-${mode}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} export failed: ${output}${errors}")
    endif()
    execute_process(COMMAND "${VALIDATOR}" "${PREFIX}-${mode}.svg"
        RESULT_VARIABLE result OUTPUT_VARIABLE validation ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} SVG failed: ${validation}${errors}")
    endif()
endfunction()
export_frames(default)
export_frames(one --frames 1)
foreach(extension svg gcode)
    file(SHA256 "${PREFIX}-default.${extension}" original)
    file(SHA256 "${PREFIX}-one.${extension}" explicit)
    if(NOT original STREQUAL explicit)
        message(FATAL_ERROR "--frames 1 changed default ${extension} bytes")
    endif()
endforeach()

export_frames(two --frames 2)
execute_process(COMMAND "${VALIDATOR}" "${PREFIX}-two-frame001.svg"
    RESULT_VARIABLE result OUTPUT_VARIABLE validation ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Second frame SVG failed: ${validation}${errors}")
endif()
execute_process(COMMAND "${CHECKER}" "${PREFIX}-two"
    RESULT_VARIABLE result OUTPUT_VARIABLE validation ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Combined G-code continuity failed: ${validation}${errors}")
endif()
message(STATUS "${validation}")
function(reject_frames label)
    execute_process(COMMAND "${EXPORTER}" "${WAD}" "${PREFIX}-invalid" --frames ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(result EQUAL 0 OR NOT "${output}${errors}" MATCHES "frames")
        message(FATAL_ERROR "Invalid frame count ${label} was not rejected: ${output}${errors}")
    endif()
    file(GLOB unexpected "${PREFIX}-invalid*")
    if(unexpected)
        message(FATAL_ERROR "Invalid frame count ${label} created output: ${unexpected}")
    endif()
endfunction()
reject_frames(missing)
foreach(value IN ITEMS 0 -1 10001 1.5 nan inf 2junk +2 " 2" 2e0)
    reject_frames("${value}" "${value}")
endforeach()
