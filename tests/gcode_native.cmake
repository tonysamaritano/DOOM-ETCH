foreach(argument GAME RUNNER PREFIX)
    if(NOT DEFINED ${argument})
        message(FATAL_ERROR "machine-gcode-native requires ${argument}")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/first_frame_helpers.cmake")
file(WRITE "${PREFIX}.gcode" "; ETCH_SIZE X170.15 Y127.6\n; ETCH_START X0 Y127.6\nG21\nG90\nF3600\nG1 X0.1 Y127.6\nM2\n")
execute_process(COMMAND "${RUNNER}" "${PREFIX}.gcode" --machine-readable
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Canonical short-file run failed: ${output}${errors}")
endif()
machine_summary("${output}" canonical)
file(MAKE_DIRECTORY "${PREFIX}-home")
foreach(rate 1 1000)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "HOME=${PREFIX}-home"
        "${GAME}" --etch-gcode "${PREFIX}.gcode"
        --etch-time-scale "${rate}" --run-frames 120
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    file(WRITE "${PREFIX}-rate-${rate}.log" "${output}${errors}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Native rate ${rate} failed: ${result} ${output}${errors}")
    endif()
    machine_summary("${output}" completed)
    if(NOT completed STREQUAL canonical)
        message(FATAL_ERROR "Actual completed native rate ${rate} changed physical report: ${completed} != ${canonical}")
    endif()
endforeach()
message(STATUS "Actual native completion at rates1/1000 matches exact CLI physical report: ${canonical}")
file(WRITE "${PREFIX}-end.gcode" "M2\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "HOME=${PREFIX}-home"
    "${GAME}" --etch-gcode "${PREFIX}-end.gcode" --run-frames 30
    RESULT_VARIABLE result OUTPUT_VARIABLE zero ERROR_VARIABLE errors TIMEOUT 15)
file(WRITE "${PREFIX}-end.log" "${zero}${errors}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Native end-only file failed: ${zero}${errors}")
endif()
string(REGEX MATCH "\\{[^\n]*\"type\":\"machine-summary\"[^\n]*\\}" completed "${zero}")
foreach(field moves erases steps_x steps_y reversals_x reversals_y simulated_seconds)
    string(JSON value GET "${completed}" ${field})
    if(NOT value EQUAL 0)
        message(FATAL_ERROR "Native end-only ${field} is nonzero: ${completed}")
    endif()
endforeach()
